rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /agents/{agentId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == agentId;
    }
    match /leads/{leadId} {
      allow read: if request.auth != null;
      allow create: if true;
    }
  }
}
