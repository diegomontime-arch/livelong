# Copy to scripts/seed/.env and adjust (optional — CLI flags work too).
# NEVER commit .env or service account JSON.

# Firebase project (default: hitlook-app from .firebaserc)
# GCLOUD_PROJECT=hitlook-app

# Service account JSON path (recommended for local seed against real project)
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccountKey.json

# --- Admin user (optional) ---
# Link an existing Auth user as company admin + seller owner:
# ADMIN_UID=your-firebase-auth-uid

# Or create / resolve by email (requires service account with Auth admin):
# ADMIN_EMAIL=admin@m4life.example
# ADMIN_PASSWORD=change-me-min-6-chars

# --- Seed IDs (optional overrides) ---
# SEED_COMPANY_ID=m4life-usa
# SEED_SELLER_ID=seller-m4life-1
# SEED_SELLER_SLUG=m4life
