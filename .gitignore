app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
# Ana chat — was excluded when it had a hardcoded Anthropic key. Since
# 2026-04 the key lives in the Cloudflare Worker (hitlook-ana-proxy) and
# the file is safe to version (verified 2026-05-26). Keeping it tracked
# stops the "file disappears on clean" footgun (planning/CHANGELOG.md).

# Seed scripts — secrets
scripts/seed/.env
scripts/seed/node_modules/
scripts/seed/*serviceAccount*.json
scripts/seed/*-firebase-adminsdk-*.json
