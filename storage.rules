rules_version = '2';

// See planning/SECURITY.md §3 (S6) for the rationale behind each block.
service firebase.storage {
  match /b/{bucket}/o {

    // -------------------------------------------------------------------
    // Agent profile photo — public read; write only by the photo owner.
    //
    // Path: agents/{uid}/photo
    // Reader: anyone (public landing page /a/{slug} renders it).
    // Writer: the agent themselves (uid == auth.uid), with size/type guards.
    // -------------------------------------------------------------------
    match /agents/{agentId}/photo {
      allow read: if true;

      allow write: if request.auth != null
        && request.auth.uid == agentId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // -------------------------------------------------------------------
    // Catch-all (explicit deny).
    // Rules v2 fails-closed by default, but documenting this block makes
    // it harder to accidentally enable broad access in future PRs.
    // -------------------------------------------------------------------
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
